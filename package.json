{
  "name": "hanzi-master",
  "version": "5.2.40",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "node scripts/run-tests.mjs",
    "check:lines": "node scripts/check-line-count.mjs",
    "check:root": "node scripts/check-root-clean.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "analyze": "node scripts/analyze.mjs",
    "i18n:lint": "node scripts/i18n-lint.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "prototype:parity": "node scripts/prototype-parity.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,mjs,js}\" \"prototype/scripts/**/*.js\" \"prototype/styles/**/*.css\"",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "security:audit:dev": "pnpm audit --audit-level=high",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "16.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/bundle-analyzer": "16.4.4",
    "@next/eslint-plugin-next": "^16.2.6",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.2.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "3.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "jsdom": "^30.1.3",
    "postcss": "8.5.15",
    "prettier": "^3.9.10",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.0.12",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=11"
  }
}
