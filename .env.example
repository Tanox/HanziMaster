# HanziMaster 环境变量示例
# 复制为 .env.local 后按需填写；应用本身无需任何环境变量即可运行。
# 本文件不含任何真实密钥，仅占位说明。

# ── 站点地址（必填于生产部署）─────────────────────────────
# 用于 metadataBase、canonical、hreflang 与 sitemap 绝对 URL。
# 本地开发可留空，回退为 http://localhost:3000。
NEXT_PUBLIC_SITE_URL=

# ── 统计（可选）──────────────────────────────────────────
# 未设置时完全不加载统计脚本；设置后仍需用户在同意横幅中选择「接受」。
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── 错误监控（可选）──────────────────────────────────────
# 只有设置 SENTRY_DSN 时才启用 withSentryConfig 包装与上报。
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# 仅 CI / 构建环境需要，用于上传 source maps；不要提交真实值。
SENTRY_AUTH_TOKEN=

# ── 打包体积分析（可选）──────────────────────────────────
# ANALYZE=1 pnpm build 会生成 bundle 分析报告（reports/）。
ANALYZE=

# ── 部署（仅 GitHub Actions 使用，配置在仓库 Secrets）────
# VERCEL_TOKEN / VERCEL_ORG_ID / VERCEL_PROJECT_ID
