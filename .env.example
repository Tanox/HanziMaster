# HanziMaster 环境变量示例
# 复制为 .env.local 后按需填写；应用本身无需任何环境变量即可运行。
# 本文件不含任何真实密钥，仅占位说明。

# ── 站点地址（生产部署必填，P0-30）─────────────────────────
# 用于 metadataBase、canonical、hreflang、sitemap 与 robots 的绝对 URL。
# 生产必须填正式域名（含 https://，结尾不要斜杠），例如 NEXT_PUBLIC_SITE_URL=https://example.com。
# 生产漏配或填入非法 URL（缺协议、带 query/hash、重复尾斜杠）会让 next.config.mjs 直接阻断构建，
# 防止 canonical / hreflang / sitemap / robots 再次全指向 localhost；site.ts 运行时仍告警回退作为最后兜底。
# 仅本地开发可留空；CI 构建须显式提供 SITE_URL（见 ci.yml）。
NEXT_PUBLIC_SITE_URL=

# ── 统计（可选）──────────────────────────────────────────
# 未设置时完全不加载统计脚本；设置后仍需用户在同意横幅中选择「接受」。
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── 错误监控（可选）──────────────────────────────────────
# 只有设置 SENTRY_DSN 时才启用 withSentryConfig 包装与上报。
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# 仅 CI / 构建环境需要，用于上传 source maps；不要提交真实值。
SENTRY_AUTH_TOKEN=

# ── 打包体积分析（可选）──────────────────────────────────
# ANALYZE=1 pnpm build 会生成 bundle 分析报告（reports/）。
ANALYZE=

# ── 云端进度同步（可选，Vercel Blob 私有 store）────────────
# 本地开发需要读写 token；Vercel 线上运行时默认走 OIDC（BLOB_STORE_ID），无需此变量。
# 创建私有 Blob store 后在 store 页面生成 Read-Write Token；不要提交真实值。
BLOB_READ_WRITE_TOKEN=

# ── 部署（仅 GitHub Actions 使用，配置在仓库 Secrets）────
# VERCEL_TOKEN / VERCEL_ORG_ID / VERCEL_PROJECT_ID
