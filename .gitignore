# Testing / generated artifacts（四类固定子目录，统一由 scripts/temp-paths.mjs 创建）
# tmp=会话临时，cache=可再生缓存，log=运行日志，reports=正式核验产物
/tmp/
/cache/
/log/
/reports/

# 历史临时目录兜底（旧会话可能仍残留 .tmp-* / _tmp_* / *_tmp*）
/.tmp/
/.tmp-*
/_tmp_*
*_tmp*
/.workbuddy

# Misc
*.pem

# pnpm-workspace.yaml 必须提交：pnpm v10+ 的 onlyBuiltDependencies / allowBuilds / overrides 均在此文件

